// DaDirt — shared dirt-simulation helpers.
//
// STATE LAYOUT (RGBA32F render target, ping-ponged each pass)
//   .r  dirt layer thickness, cm above bedrock. Always >= 0. This is the only
//       channel that carries mass, so this is the channel the volume audit sums.
//   .g  compaction. 0 = loose fluffy dirt, 1 = packed hardpack.
//   .b  moisture.   0 = bone dry, 1 = saturated.
//   .a  total surface height in cm (bedrock + .r). Redundant, but it means the
//       display material only has to sample one texture to displace the mesh.
//
// Parameters are bound by NAME: each one declared here or in a pass below must
// have a matching entry in that shader's FParameters struct in DirtSimulation.cpp.
// The three declared here are shared by every pass, so every pass's struct has
// them — even the init pass, which only reads DirtBaseHeight.

#pragma once

#include "/Engine/Public/Platform.ush"

#ifndef DIRT_THREADGROUP_SIZE
	#define DIRT_THREADGROUP_SIZE 8
#endif

#define DIRT_PI 3.14159265358979f

// --- shared bindings --------------------------------------------------------
int2 DirtResolution;
Texture2D<float> DirtBaseHeight;      // static bedrock, cm
Texture2D<float4> DirtStateIn;        // dirt state being read this pass

#ifndef UNROLL
	#define UNROLL [unroll]
#endif

// The four axis-aligned neighbours, in a fixed order. Index ^ 1 gives the
// opposite direction. Used by the smooth brush.
static const int2 DirtOffsets4[4] = { int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1) };

// All eight neighbours, opposite pairs at i and i^1, which the slump pass relies
// on to match outflow to inflow. Diagonals are sqrt(2) cells away, so a stable
// step across one is sqrt(2) times bigger. Slumping over only the four axis
// neighbours let dirt stand at atan(sqrt(2) * tan(repose)) along the diagonals —
// 41 deg for a 32 deg setting — and every pile settled into a square pyramid.
static const int2 DirtOffsets8[8] =
{
	int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1),
	int2(1, 1), int2(-1, -1), int2(1, -1), int2(-1, 1)
};
static const float DirtNeighbourDist[8] =
{
	1.0f, 1.0f, 1.0f, 1.0f,
	1.41421356f, 1.41421356f, 1.41421356f, 1.41421356f
};

bool DirtInBounds(int2 C)
{
	return all(C >= int2(0, 0)) && all(C < DirtResolution);
}

float DirtBedrock(int2 C)
{
	return DirtBaseHeight.Load(int3(C, 0)).x;
}

float4 DirtState(int2 C)
{
	return DirtStateIn.Load(int3(C, 0));
}

// Total surface height at a texel: bedrock plus whatever dirt is sitting on it.
float DirtSurface(int2 C)
{
	return DirtBedrock(C) + DirtStateIn.Load(int3(C, 0)).r;
}

// ---------------------------------------------------------------------------
// Angle of repose
// ---------------------------------------------------------------------------
// Soil strength, Mohr-Coulomb: tau = c + sigma tan(phi). docs/SoilPhysics.md.
// MIRRORED in C++ (DirtSoilStrength / DirtAllowedDropCm in DirtSimTypes.h) for
// the audit and the wheel — keep them identical.
//
//   friction  phi rises with compaction (loose 32 -> dense 42 deg) and collapses
//             as the dirt saturates: pore water carries the load, not the grains
//   cohesion  from moisture suction (a hump: none dry, none soaked, peak mid) plus
//             interlock/cementation from packing, which saturation washes out
void DirtSoilStrength(float4 S, float LooseDeg, float DenseDeg, float SuctionKPa, float PackedKPa,
					  float FrictionLoss, out float TanPhi, out float CohesionKPa)
{
	const float C = saturate(S.g);
	const float M = saturate(S.b);
	const float Sat = smoothstep(0.55f, 1.0f, M);           // pore pressure takes over past half-wet

	TanPhi = tan(radians(lerp(LooseDeg, DenseDeg, C))) * (1.0f - FrictionLoss * Sat);

	const float Suction = 4.0f * M * (1.0f - M);
	CohesionKPa = SuctionKPa * Suction + PackedKPa * C * (1.0f - Sat);
}

// Largest drop (cm) a cell may stand above a neighbour RunCm away.
//   friction: Run * tan(phi) — the angle of repose
//   cohesion: a face up to the Culmann standing height stands whole,
//             H_c(beta) = (4c/gamma) sin(beta) cos(phi) / (1 - cos(beta - phi)),
//             and a taller face keeps H_c of it. This is the sandcastle rule:
//             short damp walls stand vertical, tall ones slump to a lower angle.
float DirtAllowedDrop(float DropCm, float RunCm, float TanPhi, float CohesionKPa, float UnitWeight, float MaxHcCm)
{
	const float FrictionDrop = RunCm * TanPhi;
	if (DropCm <= FrictionDrop || CohesionKPa <= 0.0f)
	{
		return FrictionDrop;
	}

	const float Beta = atan2(DropCm, RunCm);
	const float Phi = atan(TanPhi);
	const float Denom = max(1.0f - cos(Beta - Phi), 1e-4f);
	const float Hc = min(400.0f * CohesionKPa / max(UnitWeight, 1.0f) * sin(Beta) * cos(Phi) / Denom, MaxHcCm);

	return max(FrictionDrop, (DropCm <= Hc) ? DropCm : Hc);
}

// ---------------------------------------------------------------------------
// Brush kernels
// ---------------------------------------------------------------------------
// IMPORTANT: these two functions are mirrored exactly in C++ (DirtBrush.h,
// DirtBrushCoreWeight / DirtBrushRimWeight). The CPU sums them over the brush
// footprint to get normalisation constants, which is what makes dig and raise
// conserve volume to the texel. If you change the shape here, change it there.

float DirtBrushCoreWeight(float R, float CoreRadius)
{
	if (R >= CoreRadius || CoreRadius <= 0.0f)
	{
		return 0.0f;
	}
	const float T = R / CoreRadius;
	const float F = 1.0f - T * T;
	return F * F;                    // 1 at the centre, smoothly 0 at CoreRadius
}

float DirtBrushRimWeight(float R, float CoreRadius, float RimRadius)
{
	if (R <= CoreRadius || R >= RimRadius || RimRadius <= CoreRadius)
	{
		return 0.0f;
	}
	const float T = (R - CoreRadius) / (RimRadius - CoreRadius);
	const float S = sin(DIRT_PI * T);
	return S * S;                    // 0 at both edges of the ring, 1 mid-ring
}
