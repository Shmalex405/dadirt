// DaDirt — shared dirt-simulation helpers.
//
// STATE LAYOUT (RGBA32F render target, ping-ponged each pass)
//   .r  SOLID dirt in the layer, cm. Not bulk thickness: the centimetres of
//       grains a column would make if every pore were squeezed out. This is
//       the only channel that carries mass, so this is the channel the volume
//       audit sums — and because every pass moves .r directly, packing or
//       loosening dirt changes its height but never its amount.
//   .g  compaction. 0 = loose fluffy dirt, 1 = packed hardpack.
//   .b  moisture.   0 = bone dry, 1 = saturated. A brush may push it past 1;
//       the water pass turns the excess into ponded water.
//   .a  total surface height in cm = bedrock + bulk thickness of .r. Redundant,
//       but it means the display material only has to sample one texture.
//
// A second, thinner state texture rides alongside (R32F): ponded surface water
// in cm. Only the water pass touches it.
//
// Parameters are bound by NAME: each one declared here or in a pass below must
// have a matching entry in that shader's FParameters struct in DirtSimulation.cpp.
// Those declared here are shared by every pass, so every pass's struct has them.

#pragma once

#include "/Engine/Public/Platform.ush"

#ifndef DIRT_THREADGROUP_SIZE
	#define DIRT_THREADGROUP_SIZE 8
#endif

#define DIRT_PI 3.14159265358979f

// --- shared bindings --------------------------------------------------------
int2 DirtResolution;
Texture2D<float> DirtBaseHeight;      // static bedrock, cm
Texture2D<float4> DirtStateIn;        // dirt state being read this pass

// How deep a tool's packing reaches, and the natural ground's packing below
// that. docs/SoilPhysics.md sections 1 and 4.
float DirtCompactionDepthCm;
float DirtDeepCompaction;

// --- soils -----------------------------------------------------------------
// Every cell belongs to a soil, a set of measured properties. The id is a
// static map of the site (a uint texture the CPU builds with the terrain);
// the table is what the numbers are. Five float4 rows per soil, MIRRORED in
// C++ by FDirtSoil::ToRows (DirtSimTypes.h): keep the layout identical.
//   row 0: loose porosity, dense porosity, loose friction deg, packed friction deg
//   row 1: suction cohesion kPa (peak), packed cohesion kPa, unit weight kN/m3, saturation friction loss
//   row 2: infiltration cm/s (loose), field capacity, Proctor optimum moisture, drying multiplier
//   row 3: dry colour rgb, dust motes per litre
//   row 4: packed colour rgb, (unused)
//   row 5: erodibility cm/s/Pa, critical shear Pa, settling cm/s, transport capacity per Pa
#define DIRT_MAX_SOILS 8
#define DIRT_SOIL_ROWS 6
Texture2D<uint> DirtSoilIn;
float4 DirtSoilTable[DIRT_MAX_SOILS * DIRT_SOIL_ROWS];

uint DirtSoilAt(int2 C)
{
	C = clamp(C, int2(0, 0), DirtResolution - 1);
	return min(DirtSoilIn.Load(int3(C, 0)).x, (uint)(DIRT_MAX_SOILS - 1));
}

float4 DirtSoilRow(uint Soil, uint Row)
{
	return DirtSoilTable[Soil * DIRT_SOIL_ROWS + Row];
}

#ifndef UNROLL
	#define UNROLL [unroll]
#endif

// The four axis-aligned neighbours, in a fixed order. Index ^ 1 gives the
// opposite direction. Used by the smooth brush and the water run-off.
static const int2 DirtOffsets4[4] = { int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1) };

// All eight neighbours, opposite pairs at i and i^1, which the slump pass relies
// on to match outflow to inflow. Diagonals are sqrt(2) cells away, so a stable
// step across one is sqrt(2) times bigger. Slumping over only the four axis
// neighbours let dirt stand at atan(sqrt(2) * tan(repose)) along the diagonals —
// 41 deg for a 32 deg setting — and every pile settled into a square pyramid.
static const int2 DirtOffsets8[8] =
{
	int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1),
	int2(1, 1), int2(-1, -1), int2(1, -1), int2(-1, 1)
};
static const float DirtNeighbourDist[8] =
{
	1.0f, 1.0f, 1.0f, 1.0f,
	1.41421356f, 1.41421356f, 1.41421356f, 1.41421356f
};

bool DirtInBounds(int2 C)
{
	return all(C >= int2(0, 0)) && all(C < DirtResolution);
}

float DirtBedrock(int2 C)
{
	return DirtBaseHeight.Load(int3(C, 0)).x;
}

float4 DirtState(int2 C)
{
	return DirtStateIn.Load(int3(C, 0));
}

// ---------------------------------------------------------------------------
// Solid volume <-> bulk thickness
// ---------------------------------------------------------------------------
// MIRRORED in C++ (DirtSolidFraction / DirtBulkCm / DirtSolidCm in
// DirtSimTypes.h) — keep them identical.
//
// Dirt is grains plus voids. Packing pushes the grains closer: the solid
// fraction rises from ~0.52 (loose loam) to ~0.66 (dense), so the same grains
// take up 20% less height. A tyre does not pack a whole 60 cm column though; it
// reaches roughly CompactionDepthCm down. So a column is modelled as a skin at
// the cell's compaction over a deep part at the natural-ground compaction.

float DirtSolidFraction(float C, uint Soil)
{
	const float4 R0 = DirtSoilRow(Soil, 0);
	return 1.0f - lerp(R0.x, R0.y, saturate(C));
}

// Bulk (visible) thickness of a column holding SolidCm of grains, cm.
float DirtBulkCm(float SolidCm, float C, uint Soil)
{
	const float SkinFrac = DirtSolidFraction(C, Soil);
	const float DeepFrac = DirtSolidFraction(DirtDeepCompaction, Soil);
	const float SkinSolid = SkinFrac * DirtCompactionDepthCm;
	return (SolidCm <= SkinSolid)
		? SolidCm / SkinFrac
		: DirtCompactionDepthCm + (SolidCm - SkinSolid) / DeepFrac;
}

// Inverse: the solids in a column BulkCm tall at compaction C.
float DirtSolidCm(float BulkCm, float C, uint Soil)
{
	const float SkinFrac = DirtSolidFraction(C, Soil);
	const float DeepFrac = DirtSolidFraction(DirtDeepCompaction, Soil);
	return (BulkCm <= DirtCompactionDepthCm)
		? BulkCm * SkinFrac
		: DirtCompactionDepthCm * SkinFrac + (BulkCm - DirtCompactionDepthCm) * DeepFrac;
}

// Total surface height at a texel: bedrock plus the bulk of whatever dirt is on it.
float DirtSurface(int2 C)
{
	const float4 S = DirtStateIn.Load(int3(C, 0));
	return DirtBedrock(C) + DirtBulkCm(S.r, S.g, DirtSoilAt(C));
}

// ---------------------------------------------------------------------------
// The skin
// ---------------------------------------------------------------------------
// MIRRORED in C++ (DirtPackBase / DirtUnpackBase / DirtBulkCmSkin in
// DirtSimTypes.h) - keep them identical.
//
// A column is a SKIN over a BASE. The state texture's .g and .b are the skin's
// compaction and moisture (what you see and what the knobs are in); the pond
// texture's .z is the skin's bulk thickness in cm and its .w packs the base's
// compaction and moisture into one float. A skin of zero thickness means one
// layer, and then the base is kept equal to the surface. Loose roost on a
// hardpack line, a crust dried over a damp base, the infill of a crater: all
// are a skin, and the tyre, the slump and the water read through it by its
// thickness instead of guessing from the surface alone.

float DirtPackBase(float C, float M)
{
	return floor(saturate(C) * 1000.0f + 0.5f) + saturate(M) * 0.999f;
}

void DirtUnpackBase(float W, out float C, out float M)
{
	const float F = floor(max(W, 0.0f));
	C = saturate(F / 1000.0f);
	M = saturate((W - F) / 0.999f);
}

// Bulk thickness of a column of SolidCm with a skin SkinCm thick at compaction
// Cs over a base at Cb (the base itself a packed skin over natural ground, as
// DirtBulkCm has it).
float DirtBulkCmSkin(float SolidCm, float SkinCm, float Cs, float Cb, uint Soil)
{
	const float Fs = DirtSolidFraction(Cs, Soil);
	const float SkinSolid = min(max(SkinCm, 0.0f) * Fs, max(SolidCm, 0.0f));
	return SkinSolid / Fs + DirtBulkCm(max(SolidCm, 0.0f) - SkinSolid, Cb, Soil);
}

// Surface height of a cell with its skin: state S and pond texel W.
float DirtSurfaceSkin(float4 S, float4 W, int2 P)
{
	float Cb, Mb;
	DirtUnpackBase(W.w, Cb, Mb);
	const float CbUse = (W.z > 1e-4f) ? Cb : S.g;
	return DirtBedrock(P) + DirtBulkCmSkin(S.r, W.z, S.g, CbUse, DirtSoilAt(P));
}

// Add AddSolidCm of dirt at compaction Cin and moisture Min on top of the
// column: it joins the skin, mixed by mass; a column with no skin gets one,
// and its old surface becomes the base.
void DirtSkinAdd(inout float4 S, inout float4 W, float AddSolidCm, float Cin, float Min, uint Soil)
{
	if (AddSolidCm <= 0.0f)
	{
		return;
	}
	if (W.z <= 1e-4f)
	{
		W.z = 0.0f;
		W.w = DirtPackBase(S.g, S.b);
	}
	const float Fs = DirtSolidFraction(S.g, Soil);
	const float SkinSolid = W.z * Fs;
	const float Total = SkinSolid + AddSolidCm;
	const float Cn = (SkinSolid * S.g + AddSolidCm * saturate(Cin)) / Total;
	const float Mn = (SkinSolid * S.b + AddSolidCm * saturate(Min)) / Total;
	S.g = saturate(Cn);
	S.b = saturate(Mn);
	W.z = Total / DirtSolidFraction(S.g, Soil);
	S.r += AddSolidCm;
}

// Take TakeSolidCm out of the top of the column: the skin first, the base for
// the rest. When the skin is gone the base is the surface again. (S.r is
// reduced by the caller: digs judge bedrock afterwards.)
void DirtSkinTake(inout float4 S, inout float4 W, float TakeSolidCm, uint Soil)
{
	if (TakeSolidCm <= 0.0f || W.z <= 1e-4f)
	{
		return;
	}
	const float Fs = DirtSolidFraction(S.g, Soil);
	const float SkinSolid = W.z * Fs;
	if (TakeSolidCm >= SkinSolid - 1e-5f)
	{
		float Cb, Mb;
		DirtUnpackBase(W.w, Cb, Mb);
		W.z = 0.0f;
		S.g = Cb;
		S.b = Mb;
	}
	else
	{
		W.z -= TakeSolidCm / Fs;
	}
}

// Give a column with no skin one, SkinCm thick, partitioned out of the base
// (nothing moves): what a disturbed or a drying surface does.
void DirtSkinSplit(inout float4 S, inout float4 W, float SkinCm)
{
	if (W.z <= 1e-4f && SkinCm > 0.0f)
	{
		W.w = DirtPackBase(S.g, S.b);
		W.z = SkinCm;
	}
}

// Keep the invariant: no skin means the base is the surface.
void DirtSkinSettle(inout float4 S, inout float4 W)
{
	if (W.z <= 1e-4f)
	{
		W.z = 0.0f;
		W.w = DirtPackBase(S.g, S.b);
	}
}

// ---------------------------------------------------------------------------
// Angle of repose
// ---------------------------------------------------------------------------
// Soil strength, Mohr-Coulomb: tau = c + sigma tan(phi). docs/SoilPhysics.md.
// MIRRORED in C++ (DirtSoilStrength / DirtAllowedDropCm in DirtSimTypes.h) for
// the audit and the wheel — keep them identical.
//
//   friction  phi rises with compaction (loose 32 -> dense 42 deg) and collapses
//             as the dirt saturates: pore water carries the load, not the grains
//   cohesion  from moisture suction (a hump: none dry, none soaked, peak mid) plus
//             interlock/cementation from packing, which saturation washes out
void DirtSoilStrength(float4 S, uint Soil, out float TanPhi, out float CohesionKPa)
{
	const float4 R0 = DirtSoilRow(Soil, 0);
	const float4 R1 = DirtSoilRow(Soil, 1);
	const float C = saturate(S.g);
	const float M = saturate(S.b);
	const float Sat = smoothstep(0.55f, 1.0f, M);           // pore pressure takes over past half-wet

	TanPhi = tan(radians(lerp(R0.z, R0.w, C))) * (1.0f - R1.w * Sat);

	const float Suction = 4.0f * M * (1.0f - M);
	CohesionKPa = R1.x * Suction + R1.y * C * (1.0f - Sat);
}

// Friction alone (tan phi with the saturation loss): what a rolling grain feels.
float DirtSoilFriction(float4 S, uint Soil)
{
	float TanPhi, CohesionKPa;
	DirtSoilStrength(S, Soil, TanPhi, CohesionKPa);
	return TanPhi;
}

float DirtSoilUnitWeight(uint Soil)
{
	return DirtSoilRow(Soil, 1).z;
}

// Largest drop (cm) a cell may stand above a neighbour RunCm away.
//   friction: Run * tan(phi) — the angle of repose
//   cohesion: a face up to the Culmann standing height stands whole,
//             H_c(beta) = (4c/gamma) sin(beta) cos(phi) / (1 - cos(beta - phi)),
//             and a taller face keeps H_c of it. This is the sandcastle rule:
//             short damp walls stand vertical, tall ones slump to a lower angle.
float DirtAllowedDrop(float DropCm, float RunCm, float TanPhi, float CohesionKPa, float UnitWeight, float MaxHcCm)
{
	const float FrictionDrop = RunCm * TanPhi;
	if (DropCm <= FrictionDrop || CohesionKPa <= 0.0f)
	{
		return FrictionDrop;
	}

	const float Beta = atan2(DropCm, RunCm);
	const float Phi = atan(TanPhi);
	const float Denom = max(1.0f - cos(Beta - Phi), 1e-4f);
	const float Hc = min(400.0f * CohesionKPa / max(UnitWeight, 1.0f) * sin(Beta) * cos(Phi) / Denom, MaxHcCm);

	return max(FrictionDrop, (DropCm <= Hc) ? DropCm : Hc);
}

// Proctor: how well dirt takes packing depends on its water. Bone dry it barely
// packs (grains cannot rearrange), damp it packs fast, saturated it pumps and
// will not pack at all. MIRRORED in C++ (DirtPackingEfficiency).
// The optimum moisture is the soil's (Proctor optimum): sand packs best wet,
// clay well before saturation.
float DirtPackingEfficiency(float Moisture, uint Soil)
{
	const float M = saturate(Moisture);
	const float Opt = DirtSoilRow(Soil, 2).z;
	const float Hump = smoothstep(Opt - 0.75f, Opt + 0.15f, M);       // rises from ~0.3 dry to 1 at optimum
	const float Mud = 1.0f - smoothstep(Opt + 0.3f, 1.0f, M);         // past optimum it pumps
	return (0.35f + 0.65f * Hump) * Mud;
}

// ---------------------------------------------------------------------------
// Brush kernels
// ---------------------------------------------------------------------------
// IMPORTANT: these two functions are mirrored exactly in C++ (DirtSimTypes.h,
// DirtBrushCoreWeight / DirtBrushRimWeight). The CPU sums them over the brush
// footprint to get normalisation constants, which is what makes dig and raise
// conserve volume to the texel. If you change the shape here, change it there.

float DirtBrushCoreWeight(float R, float CoreRadius)
{
	if (R >= CoreRadius || CoreRadius <= 0.0f)
	{
		return 0.0f;
	}
	const float T = R / CoreRadius;
	const float F = 1.0f - T * T;
	return F * F;                    // 1 at the centre, smoothly 0 at CoreRadius
}

float DirtBrushRimWeight(float R, float CoreRadius, float RimRadius)
{
	if (R <= CoreRadius || R >= RimRadius || RimRadius <= CoreRadius)
	{
		return 0.0f;
	}
	const float T = (R - CoreRadius) / (RimRadius - CoreRadius);
	const float S = sin(DIRT_PI * T);
	return S * S;                    // 0 at both edges of the ring, 1 mid-ring
}

// ---------------------------------------------------------------------------
// Deposits from parcels
// ---------------------------------------------------------------------------
// Airborne dirt lands by atomically adding its volume into a fixed-point uint
// texture, which the deposit pass folds into the layer at the start of the next
// step. Fixed point because float atomics are not guaranteed on every GPU.
// 65536 steps per cm^3 so a 3 mm grain (0.014 cm^3) rounds to 0.05%; a cell can
// take 65 litres in one step before it wraps.
#define DIRT_DEPOSIT_SCALE 65536.0f

// Parcel counters (a small uint buffer, read back to the CPU a frame or two late).
// Must match DirtSim::ParcelCounter* in DirtSimulation.h.
#define DIRT_PARCEL_COUNTER_FREE     0   // free slots
#define DIRT_PARCEL_COUNTER_SPAWNED  1   // total ever spawned
#define DIRT_PARCEL_COUNTER_LANDED   2   // total ever deposited
#define DIRT_PARCEL_COUNTER_FALLBACK 3   // spawns that found the pool full
#define DIRT_PARCEL_COUNTER_MAXLIVE  4   // highest live slot + 1, this step
#define DIRT_PARCEL_COUNTER_COUNT    8

// Scoop shortfall: when a Scoop stroke finds less dirt than it asked for (the
// cell is down to bedrock), the brush pass records the missing cm^3 here,
// fixed point, by the stroke's index within the step. The parcels spawned for
// that scoop are shrunk by it, so they never land dirt that never left.
#define DIRT_MAX_STROKES_PER_STEP 256
