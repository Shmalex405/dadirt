// DaDirt — dirt simulation compute passes.
//
//   MainInitCS     seed the state from the CPU-built terrain
//   MainShiftCS    slide the window by whole tiles; entering cells come from a patch
//   MainDepositCS  fold landed parcels (airborne dirt) back into the layer
//   MainBrushCS    apply a batch of deformation strokes (dig / raise / smooth / wet / pack ...)
//   MainSlumpCS    angle-of-repose relaxation: dirt too steep to stand avalanches
//   MainWaterCS    ponded water runs off and soaks in; moisture drains and dries
//   MainResolveCS  derive the surface normal and the debug colour for display
//
// The passes ping-pong between two RGBA32F state textures (and the water pass
// between two R32F pond textures). See DirtCommon.ush for the channel layout.

#include "DirtCommon.ush"
#include "DirtParcelCommon.ush"

// ---------------------------------------------------------------------------
// Init — seed the simulation state from the CPU-built terrain
// ---------------------------------------------------------------------------

#if DIRT_INIT_PASS

Texture2D<float4> DirtInitialState;   // CPU-built starting state (.r already solid cm)
RWTexture2D<float4> DirtStateOut;
RWTexture2D<float2> DirtPondOut;      // x ponded water cm, y suspended solid cm

[numthreads(DIRT_THREADGROUP_SIZE, DIRT_THREADGROUP_SIZE, 1)]
void MainInitCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 P = int2(DispatchThreadId.xy);
	if (!DirtInBounds(P))
	{
		return;
	}

	float4 S = DirtInitialState.Load(int3(P, 0));
	S.r = max(S.r, 0.0f);
	S.g = saturate(S.g);
	S.b = saturate(S.b);
	S.a = DirtBedrock(P) + DirtBulkCm(S.r, S.g, DirtSoilAt(P));      // derive the surface rather than trusting the upload

	DirtStateOut[P] = S;
	DirtPondOut[P] = float2(0.0f, 0.0f);
}

#endif // DIRT_INIT_PASS

// ---------------------------------------------------------------------------
// Shift — the simulated window slides by whole tiles over a bigger world
// ---------------------------------------------------------------------------
// The tiles that stay are moved within the texture; the cells that enter are
// read from a patch the CPU uploaded (a cached tile that comes back, or fresh
// ground from the builder). Bedrock was already shifted and re-uploaded by the
// CPU, so the surface is recomputed here rather than trusted.

#if DIRT_SHIFT_PASS

int2 DirtShiftTexels;                 // old texel = new texel + shift
Texture2D<float4> DirtPatchState;     // entering cells, already in NEW texel coordinates
Texture2D<float2> DirtPatchPond;
Texture2D<float2> DirtPondIn;
RWTexture2D<float4> DirtStateOut;
RWTexture2D<float2> DirtPondOut;      // x ponded water cm, y suspended solid cm

[numthreads(DIRT_THREADGROUP_SIZE, DIRT_THREADGROUP_SIZE, 1)]
void MainShiftCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 P = int2(DispatchThreadId.xy);
	if (!DirtInBounds(P))
	{
		return;
	}

	const int2 Q = P + DirtShiftTexels;
	float4 S;
	float2 Pond;
	if (DirtInBounds(Q))
	{
		S = DirtState(Q);
		Pond = DirtPondIn.Load(int3(Q, 0)).xy;
	}
	else
	{
		// Taken exactly as stored: any clamp here would create or destroy dirt
		// that the ledger has already counted.
		S = DirtPatchState.Load(int3(P, 0));
		Pond = DirtPatchPond.Load(int3(P, 0)).xy;
	}
	S.a = DirtBedrock(P) + DirtBulkCm(S.r, S.g, DirtSoilAt(P));

	DirtStateOut[P] = S;
	DirtPondOut[P] = Pond;
}

#endif // DIRT_SHIFT_PASS

// ---------------------------------------------------------------------------
// Deposit — airborne dirt that has landed joins the layer
// ---------------------------------------------------------------------------
// The parcel sim adds (volume, volume x moisture) into two fixed-point textures
// with atomics. This pass converts them to solid centimetres, blends them onto
// the surface, and zeroes the accumulators for the next step.

#if DIRT_DEPOSIT_PASS

float DirtDepositCompaction;       // landed dirt is loose
int DirtResetLiveMax;              // 1 when a parcel sim pass follows this step and will recount
RWTexture2D<float4> DirtStateOut;

[numthreads(DIRT_THREADGROUP_SIZE, DIRT_THREADGROUP_SIZE, 1)]
void MainDepositCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 P = int2(DispatchThreadId.xy);
	if (!DirtInBounds(P))
	{
		return;
	}

	// The highest-live-slot counter is a per-step maximum; start it over before
	// this step's spawn and sim passes raise it again.
	if (all(P == int2(0, 0)) && DirtResetLiveMax != 0)
	{
		DirtParcelCounters[DIRT_PARCEL_COUNTER_MAXLIVE] = 0u;
	}

	float4 S = DirtState(P);
	const uint VolFixed = DirtDepositVol[P];
	if (VolFixed > 0u)
	{
		const float VolumeCm3 = (float)VolFixed / DIRT_DEPOSIT_SCALE;
		const float Moisture = (float)DirtDepositMoist[P] / max((float)VolFixed, 1.0f);
		const float AddCm = VolumeCm3 / DirtTexelAreaCm2;

		// Same skin rule as the slump: what lands sits on top and owns the
		// surface once there is a couple of centimetres of it.
		const float SkinCm = 2.0f;
		const float W = AddCm / (AddCm + SkinCm);
		S.b = saturate(lerp(S.b, Moisture, W));
		S.g = saturate(lerp(S.g, DirtDepositCompaction, W));
		S.r += AddCm;
		S.a = DirtBedrock(P) + DirtBulkCm(S.r, S.g, DirtSoilAt(P));

		DirtDepositVol[P] = 0u;
		DirtDepositMoist[P] = 0u;
	}

	DirtStateOut[P] = S;
}

#endif // DIRT_DEPOSIT_PASS

// ---------------------------------------------------------------------------
// Brush
// ---------------------------------------------------------------------------

#if DIRT_BRUSH_PASS

// Up to DIRT_MAX_STROKES strokes are applied in one pass, in order. A rolling
// ball or a spinning wheel emits strokes every frame, and one full-grid pass per
// stroke would not scale; one pass per batch does. Must match
// DirtSim::MaxStrokesPerPass in DirtSimulation.h.
#define DIRT_MAX_STROKES 16

int DirtStrokeCount;
int DirtStrokeBase;                     // index of this batch's first stroke within the step
float4 DirtStrokeA[DIRT_MAX_STROKES];   // centre.xy (cells), core radius, rim radius
float4 DirtStrokeB[DIRT_MAX_STROKES];   // core norm, rim norm, amount, disturb
float4 DirtStrokeC[DIRT_MAX_STROKES];   // mode (as float), proctor flag, linked taking stroke (-1 none), unused

RWTexture2D<float4> DirtStateOut;
RWStructuredBuffer<uint> DirtScoopShortfall;

void ApplyStroke(int2 P, int K, inout float4 S, inout float ScoopWant)
{
	const float2 Centre     = DirtStrokeA[K].xy;
	const float  CoreRadius = DirtStrokeA[K].z;
	const float  RimRadius  = DirtStrokeA[K].w;
	const float  CoreNorm   = DirtStrokeB[K].x;
	const float  RimNorm    = DirtStrokeB[K].y;
	const float  Amount     = DirtStrokeB[K].z;
	const float  Disturb    = DirtStrokeB[K].w;
	const int    Mode       = (int)DirtStrokeC[K].x;
	const bool   bProctor   = DirtStrokeC[K].y > 0.5f;
	const int    Link       = (int)DirtStrokeC[K].z;

	const float R = length((float2(P) + 0.5f) - Centre);
	if (R >= RimRadius + 1.0f)
	{
		return;
	}

	const float Core = DirtBrushCoreWeight(R, CoreRadius);
	const float Rim  = DirtBrushRimWeight(R, CoreRadius, RimRadius);

	// Normalised so that summing each kernel over the whole footprint gives
	// exactly 1.0. That is what makes dig and raise zero-sum: whatever the
	// core loses, the rim gains. Amounts for the mass modes are SOLID cm.
	const float CoreW = (CoreNorm > 0.0f) ? Core / CoreNorm : 0.0f;
	const float RimW  = (RimNorm  > 0.0f) ? Rim  / RimNorm  : 0.0f;
	const float Mask  = saturate(Core + Rim);

	// Every stroke that moves dirt is two halves: a TAKING half that runs first
	// and records, per stroke, whatever it could not find (a cell down to
	// bedrock), and a GIVING half that runs in a later batch and gives only what
	// was actually taken. That is what keeps a dig zero-sum over a hole: the
	// core cannot give what it does not have, so the rim must not receive it.
	//   DIG   = 0 core take   ->  8 rim give
	//   RAISE = 1 rim take    -> 10 core give
	//   SCOOP = 6 core take   ->  7 DUMP give (a transfer) or parcels
	const float Give = (Link >= 0 && Link < DIRT_MAX_STROKES_PER_STEP && Amount > 0.0f)
		? saturate(1.0f - ((float)DirtScoopShortfall[Link] / DIRT_DEPOSIT_SCALE / DirtTexelAreaCm2) / Amount)
		: 1.0f;

	if (Mode == 0)         // DIG, taking half: scoop the core out
	{
		ScoopWant = Amount * CoreW;
		S.r -= ScoopWant;
	}
	else if (Mode == 1)    // RAISE, taking half: borrow from the rim
	{
		ScoopWant = Amount * RimW;
		S.r -= ScoopWant;
	}
	else if (Mode == 8)    // DIG, giving half: heap what was taken on the rim
	{
		S.r += Amount * RimW * Give;
	}
	else if (Mode == 10)   // RAISE, giving half: pile what was borrowed on the core
	{
		S.r += Amount * CoreW * Give;
	}
	else if (Mode == 2)    // SMOOTH — pull toward the local average (of the pre-pass state)
	{
		float Sum = S.r;
		float Count = 1.0f;
		UNROLL
		for (int i = 0; i < 4; ++i)
		{
			const int2 Q = P + DirtOffsets4[i];
			if (DirtInBounds(Q))
			{
				Sum += DirtState(Q).r;
				Count += 1.0f;
			}
		}
		S.r = lerp(S.r, Sum / Count, saturate(Amount) * Mask);
	}
	else if (Mode == 3)    // WET — may exceed 1: the water pass ponds the excess
	{
		S.b = clamp(S.b + Amount * Mask, 0.0f, 50.0f);
	}
	else if (Mode == 4)    // PACK
	{
		const float Efficiency = bProctor ? DirtPackingEfficiency(S.b, DirtSoilAt(P)) : 1.0f;
		S.g = saturate(S.g + Amount * Efficiency * Mask);
	}
	else if (Mode == 5)    // LOOSEN
	{
		S.g = saturate(S.g - Amount * Mask);
	}
	else if (Mode == 6)    // SCOOP — take dirt out of the core; the volume goes elsewhere
	{
		// Remembered, so that whatever the whole batch fails to find at this cell
		// can be charged back to the scoops that asked for it (see ApplyBrush).
		ScoopWant = Amount * CoreW;
		S.r -= ScoopWant;
	}
	else if (Mode == 7)    // DUMP — the giving half of a SCOOP. Arrives loose.
	{
		S.r += Amount * CoreW * Give;
	}

	// Dirt you have just moved is broken-up dirt — it loses its pack. The
	// taking halves carry the disturb; the giving halves have none.
	if (Mode <= 2 || Mode == 6 || Mode == 7)
	{
		S.g = saturate(S.g - Disturb * Mask);
	}
}

void ApplyBrush(int2 P)
{
	float4 S = DirtState(P);
	const float Bed = DirtBedrock(P);

	float ScoopWant[DIRT_MAX_STROKES];
	float WantSum = 0.0f;

	[loop]
	for (int K = 0; K < DirtStrokeCount; ++K)
	{
		ScoopWant[K] = 0.0f;
		ApplyStroke(P, K, S, ScoopWant[K]);
		WantSum += ScoopWant[K];
	}

	// Bedrock is the floor. You cannot dig below it. Judged once, after every
	// stroke of the batch has had its say (a rut's spoil rim may land on the
	// cell a scoop just emptied). Whatever the scoops asked for beyond that is
	// reported, split by how much each asked, so the parcels spawned for them
	// carry only dirt that actually left the ground. A Dig that hits bedrock
	// still loses quietly, and DaDirt.Audit reports exactly how much.
	if (S.r < 0.0f && WantSum > 0.0f)
	{
		const float ShortCm = min(-S.r, WantSum);
		[loop]
		for (int K = 0; K < DirtStrokeCount; ++K)
		{
			const int Index = DirtStrokeBase + K;
			if (ScoopWant[K] > 0.0f && Index < DIRT_MAX_STROKES_PER_STEP)
			{
				InterlockedAdd(DirtScoopShortfall[Index],
							   (uint)(ShortCm * ScoopWant[K] / WantSum * DirtTexelAreaCm2 * DIRT_DEPOSIT_SCALE + 0.5f));
			}
		}
	}
	S.r = max(S.r, 0.0f);
	S.a = Bed + DirtBulkCm(S.r, S.g, DirtSoilAt(P));

	DirtStateOut[P] = S;
}

[numthreads(DIRT_THREADGROUP_SIZE, DIRT_THREADGROUP_SIZE, 1)]
void MainBrushCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 P = int2(DispatchThreadId.xy);
	if (!DirtInBounds(P))
	{
		return;
	}
	ApplyBrush(P);
}

#endif // DIRT_BRUSH_PASS

// ---------------------------------------------------------------------------
// Slump (angle of repose)
// ---------------------------------------------------------------------------
// Mass-conserving gather formulation. Each thread writes only its own texel, so
// to stay exactly zero-sum it computes both what flows OUT of this texel and what
// flows IN from each neighbour — recomputing the neighbour's outflow with the
// identical function. Every centimetre that leaves one texel arrives at another.
//
// Slopes are judged on the bulk surface; what moves is solid dirt, converted at
// the source cell's solid fraction. Because .r is solid, the sum is exact no
// matter how differently packed the two ends are.
//
// Eight neighbours, not four: see DirtOffsets8 in DirtCommon.ush for why. Flow
// across a diagonal is divided by its sqrt(2) distance (flux follows gradient),
// which also keeps the total a cell can shed per iteration under ~0.7 of its
// excess, so the scheme cannot overshoot and oscillate.
//
// It runs on a 16 x 16 tile held in group shared memory with a two-cell halo:
// about 1.6 texture loads per cell instead of 81. The tile version was measured
// against the straight one on the soil tests before it replaced it.

#if DIRT_SLUMP_PASS

float DirtTexelSizeCm;
float DirtMaxCohesiveHeightCm;
float DirtSlumpRate;
float DirtLooseningRate;
float DirtLooseningScaleCm;

// Grains shedding down an over-steep face: a cell that avalanches hard enough
// may turn part of what it sheds into a parcel that rolls off instead. Volume is
// conserved: the parcel's dirt is taken out of the cell before it is written.
int DirtShedEnabled;
float DirtShedMinOutCm;            // a cell must be shedding at least this much this iteration
float DirtShedChance;              // per qualifying cell per iteration
float DirtShedFraction;            // share of the cell's outflow that leaves as a parcel
float DirtShedDiameterCm;
float DirtShedSpeedCmS;
uint DirtFrameSeed;

RWTexture2D<float4> DirtStateOut;

// One 16 x 16 tile of cells per group, plus a 2-cell halo, held in group shared
// memory: every cell needs its neighbours' outflows, and every neighbour's
// outflow needs ITS neighbours, so two rings. 400 loads per 256 threads instead
// of 81 per thread. TILE_OUT is the tile plus one ring: the cells whose outflow
// is computed and then gathered from.
#define SLUMP_TILE 16
#define DIRT_SLUMP_MIN_FLOW_CM 1e-4f      // solid cm per iteration per neighbour; see ComputeOutflowTile
#define SLUMP_HALO 2
#define SLUMP_W (SLUMP_TILE + 2 * SLUMP_HALO)     // 20
#define SLUMP_OUT (SLUMP_TILE + 2)                // 18

groupshared float4 TileState[SLUMP_W * SLUMP_W];
groupshared float TileOut[SLUMP_OUT * SLUMP_OUT * 9];    // 8 outflows + scale per cell

float4 TileAt(int2 T)
{
	return TileState[T.y * SLUMP_W + T.x];
}

// Unscaled solid outflow from tile cell T toward each of its eight neighbours,
// plus the factor needed to keep it from moving more dirt than the cell has.
// A cell outside the box is stored with a negative layer; it neither gives nor
// takes: the walls of the box are sealed.
void ComputeOutflowTile(int2 T, int2 Cell, out float Out[8], out float Scale)
{
	const float4 S = TileAt(T);
	if (S.r < 0.0f)
	{
		UNROLL
		for (int k = 0; k < 8; ++k)
		{
			Out[k] = 0.0f;
		}
		Scale = 0.0f;
		return;
	}

	const float Surface = S.a;              // bedrock + bulk layer, maintained by every pass
	const uint Soil = DirtSoilAt(Cell);
	const float Solid = DirtSolidFraction(S.g, Soil);
	const float UnitWeight = DirtSoilUnitWeight(Soil);

	float TanPhi, CohesionKPa;
	DirtSoilStrength(S, Soil, TanPhi, CohesionKPa);

	float Sum = 0.0f;

	UNROLL
	for (int i = 0; i < 8; ++i)
	{
		const float4 SQ = TileAt(T + DirtOffsets8[i]);
		if (SQ.r < 0.0f)
		{
			Out[i] = 0.0f;              // the walls of the box are sealed
			continue;
		}

		// Only the part of the drop that is steeper than this dirt can hold moves.
		// A diagonal neighbour is further away, so it tolerates a bigger drop and
		// receives proportionally less flow.
		const float Dist = DirtNeighbourDist[i];
		const float Drop = Surface - SQ.a;
		const float Excess = max(0.0f, Drop - DirtAllowedDrop(Drop, DirtTexelSizeCm * Dist, TanPhi, CohesionKPa,
															 UnitWeight, DirtMaxCohesiveHeightCm));
		Out[i] = Excess * Solid * DirtSlumpRate / Dist;

		// Flows are moved in float: taken from this cell in one subtraction and
		// added to the neighbour in another. Below half a float step of either
		// cell's depth the rounding is one-sided (a thick cell giving to a thin
		// one drops the flow, the thin one still receives it) and the slump
		// quietly manufactures dirt on every face that is still creeping. A floor
		// far above that step (a 0.03 degree excess at 4 cm cells) stops the
		// creep instead. docs/SoilPhysics.md 9h.
		Out[i] = (Out[i] >= DIRT_SLUMP_MIN_FLOW_CM) ? Out[i] : 0.0f;
		Sum += Out[i];
	}

	// A cell may shed at most half its dirt per iteration. Letting it empty
	// completely made thin sheets of mud on steep bedrock flip-flop: a cell
	// drains, refills from uphill next iteration, drains again, and neighbours
	// lock into an odd-even checkerboard of thick and thin that renders as teeth.
	const float MaxOut = 0.5f * S.r;
	Scale = (Sum > MaxOut) ? (MaxOut / max(Sum, 1e-6f)) : 1.0f;
}

[numthreads(SLUMP_TILE, SLUMP_TILE, 1)]
void MainSlumpCS(uint3 DispatchThreadId : SV_DispatchThreadID, uint3 GroupId : SV_GroupID,
				 uint3 GroupThreadId : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
{
	const int2 P = int2(DispatchThreadId.xy);
	const int2 TileOrigin = int2(GroupId.xy) * SLUMP_TILE - SLUMP_HALO;

	// 1. Everyone loads the tile. Out-of-box cells get a negative layer.
	for (uint Idx = GroupIndex; Idx < SLUMP_W * SLUMP_W; Idx += SLUMP_TILE * SLUMP_TILE)
	{
		const int2 C = TileOrigin + int2(Idx % SLUMP_W, Idx / SLUMP_W);
		TileState[Idx] = DirtInBounds(C) ? DirtState(C) : float4(-1.0f, 0.0f, 0.0f, 0.0f);
	}
	GroupMemoryBarrierWithGroupSync();

	// 2. Outflows for the tile and one ring around it, so the gather below can
	//    read every neighbour's outflow without recomputing it.
	for (uint Idx = GroupIndex; Idx < SLUMP_OUT * SLUMP_OUT; Idx += SLUMP_TILE * SLUMP_TILE)
	{
		const int2 T = int2(Idx % SLUMP_OUT, Idx / SLUMP_OUT) + 1;    // tile coords: ring starts at 1
		float Out[8];
		float Scale;
		ComputeOutflowTile(T, TileOrigin + T, Out, Scale);
		UNROLL
		for (int i = 0; i < 8; ++i)
		{
			TileOut[Idx * 9 + i] = Out[i];
		}
		TileOut[Idx * 9 + 8] = Scale;
	}
	GroupMemoryBarrierWithGroupSync();

	if (!DirtInBounds(P))
	{
		return;
	}

	// 3. Gather. This thread's cell in tile coords and in outflow-ring coords.
	const int2 L = int2(GroupThreadId.xy) + 1;                       // ring coords (0..17), ours at 1..16
	const int2 T = L + 1;                                            // tile coords
	float4 S = TileAt(T);
	const float Bed = DirtBedrock(P);

	const int OwnIdx = L.y * SLUMP_OUT + L.x;
	const float ScaleP = TileOut[OwnIdx * 9 + 8];
	float TotalOut = 0.0f;
	UNROLL
	for (int i = 0; i < 8; ++i)
	{
		TotalOut += TileOut[OwnIdx * 9 + i] * ScaleP;
	}

	float TotalIn = 0.0f;
	float InMoisture = 0.0f;      // inflow weighted by the source cell's moisture
	float InCompaction = 0.0f;    // inflow weighted by the source cell's compaction
	UNROLL
	for (int j = 0; j < 8; ++j)
	{
		const int2 LQ = L + DirtOffsets8[j];
		const int QIdx = LQ.y * SLUMP_OUT + LQ.x;
		// j^1 flips the direction: neighbour Q's flow back toward us.
		const float In = TileOut[QIdx * 9 + (j ^ 1)] * TileOut[QIdx * 9 + 8];
		const float4 SQ = TileAt(T + DirtOffsets8[j]);
		TotalIn += In;
		InMoisture += In * saturate(SQ.b);
		InCompaction += In * SQ.g;
	}

	const float Retained = max(S.r - TotalOut, 0.0f);
	float NewLayer = Retained + TotalIn;

	// Dirt carries its water and its packing with it, and the state channels
	// describe the SURFACE: a sheet of mud arriving on a damp column lands on
	// top, so it takes the surface over quickly rather than averaging into 60 cm
	// of what was underneath. Averaged over the whole column, the receiving cell
	// stayed cohesive, became a dam for the next inflow, and a wet/dry boundary
	// turned into a saw-tooth of held and drained cells. The skin depth is how
	// much arriving dirt it takes to own the surface.
	if (TotalIn > 1e-4f)
	{
		const float SkinCm = 2.0f;
		const float W = TotalIn / (TotalIn + SkinCm);
		S.b = lerp(S.b, InMoisture / TotalIn, W);
		S.g = saturate(lerp(S.g, InCompaction / TotalIn, W));
	}

	// Avalanching dirt is tumbling dirt, so whatever moved arrives loose; nothing
	// re-packs it on its own — only a wheel, a tool, or a Pack brush.
	const float Loosen = saturate((TotalOut + TotalIn) / max(DirtLooseningScaleCm, 1e-4f)) * DirtLooseningRate;
	S.g = saturate(S.g - Loosen);

	// --- grains shedding down the face ------------------------------------------------
	// A cell avalanching hard enough may send part of what it sheds off as a
	// parcel instead: it rolls down the face as a visible grain and deposits
	// wherever it stops, which the heightfield alone could not show. The parcel's
	// dirt is taken out of this cell here, so the books still balance.
	if (DirtShedEnabled != 0 && TotalOut >= DirtShedMinOutCm)
	{
		const uint Seed = DirtHash((uint)P.x * 73856093u ^ (uint)P.y * 19349663u ^ DirtFrameSeed);
		if (DirtRand01(Seed, 1u) < DirtShedChance)
		{
			// A grain carries what a grain of its drawn size can (a few of them,
			// as it stands in for its neighbours), never a cell's worth: mud that
			// runs out fast was shedding 20 cm3 "grains" drawn 6 mm across.
			const float Diameter = DirtShedDiameterCm * (0.7f + 0.6f * DirtRand01(Seed, 4u));
			const float GrainCm3 = 4.0f * DIRT_PI / 6.0f * Diameter * Diameter * Diameter;
			const float ParcelSolidCm = min(min(DirtShedFraction * TotalOut, 0.5f * NewLayer),
											GrainCm3 / (DirtTexelSizeCm * DirtTexelSizeCm));
			const float VolumeCm3 = ParcelSolidCm * DirtTexelSizeCm * DirtTexelSizeCm;
			if (VolumeCm3 > 0.01f)
			{
				uint Old;
				InterlockedAdd(DirtParcelCounters[DIRT_PARCEL_COUNTER_FREE], 0xFFFFFFFFu, Old);
				if (Old == 0u || Old > ParcelCount())
				{
					InterlockedAdd(DirtParcelCounters[DIRT_PARCEL_COUNTER_FREE], 1u);   // pool full: stay in the ground
				}
				else
				{
					const uint Slot = DirtParcelFree[Old - 1u];
					InterlockedMax(DirtParcelCounters[DIRT_PARCEL_COUNTER_MAXLIVE], Slot + 1u);
					InterlockedAdd(DirtParcelCounters[DIRT_PARCEL_COUNTER_SPAWNED], 1u);
					NewLayer -= ParcelSolidCm;

					// Downhill: toward the neighbours this cell is shedding to.
					float2 Down = float2(0, 0);
					UNROLL
					for (int k = 0; k < 8; ++k)
					{
						Down += float2(DirtOffsets8[k]) * TileOut[OwnIdx * 9 + k];
					}
					Down = (length(Down) > 1e-6f) ? normalize(Down) : float2(1, 0);
					const float2 Side = float2(-Down.y, Down.x) * (DirtRand01(Seed, 2u) - 0.5f) * 0.6f;
					const float3 Vel = float3((Down + Side) * DirtShedSpeedCmS * (0.6f + 0.8f * DirtRand01(Seed, 3u)), DirtShedSpeedCmS * 0.3f);

					const float2 XY = DirtRegionOriginCm + (float2(P) + float2(DirtRand01(Seed, 5u), DirtRand01(Seed, 6u))) * DirtTexelSizeCm;
					const float Z = Bed + DirtBulkCm(NewLayer, S.g, DirtSoilAt(P)) + Diameter;

					const int2 PT = ParcelTexel(Slot);
					DirtParcelPos[PT] = float4(XY, Z, VolumeCm3);
					DirtParcelVel[PT] = float4(Vel, 0.0f);
					DirtParcelProp[PT] = float4(saturate(S.b), saturate(S.g), Diameter, (float)(Seed & 0xFFFFu));
				}
			}
		}
	}

	S.r = NewLayer;
	S.a = Bed + DirtBulkCm(NewLayer, S.g, DirtSoilAt(P));

	DirtStateOut[P] = S;
}

#endif // DIRT_SLUMP_PASS

// ---------------------------------------------------------------------------
// Water — run-off, infiltration, drainage, drying
// ---------------------------------------------------------------------------
// docs/SoilPhysics.md section 5. Once per sim step:
//   1. ponded water runs downhill over the surface (four neighbours, gather form)
//   2. rain lands on the pond
//   3. the pond soaks in at the soil's conductivity, which packing throttles
//   4. moisture past saturation overflows back out as pond
//   5. moisture above field capacity drains away downward, slower when packed
//   6. the surface dries
// Pore space per cell is porosity x the wet skin the moisture channel describes.

#if DIRT_WATER_PASS

float DirtDt;
float DirtTexelSizeCm;
int DirtErosionEnabled;
float DirtErosionPace;            // erodibility and capacity run at the water's game pace
float DirtRunoffRate;
float DirtRainCmPerSec;
float DirtDrainPerSec;            // of the water above field capacity, loose dirt
float DirtEvapPerSec;
float DirtWetDepthCm;
float DirtAmbientMoisture;        // air-dry dirt keeps this much (hygroscopic water)

// Water poured on a spot this step (a water truck): lands as pond, then soaks in
// at the soil's own rate, so it puddles on hardpack and vanishes into sand.
// Must match DirtSim::MaxWaterSourcesPerPass.
#define DIRT_MAX_WATER_SOURCES 16
int DirtWaterSourceCount;
float4 DirtWaterSource[DIRT_MAX_WATER_SOURCES];   // centre.xy (cells), core radius, cm per unit kernel weight

Texture2D<float2> DirtPondIn;
RWTexture2D<float2> DirtPondOut;      // x ponded water cm, y suspended solid cm
RWTexture2D<float4> DirtStateOut;

float PondHead(int2 Q)
{
	return DirtState(Q).a + DirtPondIn.Load(int3(Q, 0)).x;
}

void ComputePondOutflow(int2 P, out float Out[4], out float Scale)
{
	const float Pond = DirtPondIn.Load(int3(P, 0)).x;
	const float Head = PondHead(P);
	float Sum = 0.0f;

	UNROLL
	for (int i = 0; i < 4; ++i)
	{
		const int2 Q = P + DirtOffsets4[i];
		Out[i] = 0.0f;
		if (DirtInBounds(Q) && Pond > 1e-4f)
		{
			// Water can only fall as far as levelling the two heads.
			Out[i] = DirtRunoffRate * max(0.0f, Head - PondHead(Q)) * 0.5f;
			Sum += Out[i];
		}
	}

	Scale = (Sum > Pond) ? (Pond / max(Sum, 1e-6f)) : 1.0f;
}

[numthreads(DIRT_THREADGROUP_SIZE, DIRT_THREADGROUP_SIZE, 1)]
void MainWaterCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 P = int2(DispatchThreadId.xy);
	if (!DirtInBounds(P))
	{
		return;
	}

	float4 S = DirtState(P);
	const float2 PW = DirtPondIn.Load(int3(P, 0)).xy;
	float Pond = PW.x;
	float Sed = PW.y;                 // solid cm of dirt suspended in this cell's water
	const float PondBefore = Pond;
	float SedIn = 0.0f;
	float MaxBedDropCm = 0.0f;        // steepest fall of the BED toward a neighbour the water flows to

	// 1. run-off
	float OutP[4];
	float ScaleP;
	ComputePondOutflow(P, OutP, ScaleP);
	float Moved = 0.0f;
	UNROLL
	for (int i = 0; i < 4; ++i)
	{
		Moved += OutP[i] * ScaleP;
		const int2 Q = P + DirtOffsets4[i];
		if (DirtInBounds(Q))
		{
			float OutQ[4];
			float ScaleQ;
			ComputePondOutflow(Q, OutQ, ScaleQ);
			const float In = OutQ[i ^ 1] * ScaleQ;
			Pond += In;
			// The dirt in that water comes along with it, in proportion.
			const float2 QW = DirtPondIn.Load(int3(Q, 0)).xy;
			SedIn += (QW.x > 1e-5f) ? QW.y * min(In / QW.x, 1.0f) : 0.0f;
			if (OutP[i] > 0.0f)
			{
				MaxBedDropCm = max(MaxBedDropCm, S.a - DirtState(Q).a);
			}
		}
	}
	const float SedOut = (PondBefore > 1e-5f) ? Sed * min(Moved / PondBefore, 1.0f) : 0.0f;
	Pond = max(Pond - Moved, 0.0f);
	Sed = max(Sed - SedOut, 0.0f) + SedIn;

	// 2. rain, and anything poured from a truck
	Pond += DirtRainCmPerSec * DirtDt;
	[loop]
	for (int k = 0; k < DirtWaterSourceCount; ++k)
	{
		const float R = length((float2(P) + 0.5f) - DirtWaterSource[k].xy);
		Pond += DirtWaterSource[k].w * DirtBrushCoreWeight(R, DirtWaterSource[k].z);
	}

	// 3. infiltration. Compaction lowers conductivity by ~two orders of magnitude.
	const float C = saturate(S.g);
	const uint Soil = DirtSoilAt(P);
	const float4 SoilR0 = DirtSoilRow(Soil, 0);
	const float4 SoilR2 = DirtSoilRow(Soil, 2);
	const float PoreCm = max(lerp(SoilR0.x, SoilR0.y, C) * min(S.a - DirtBedrock(P), DirtWetDepthCm), 0.05f);
	const float K = SoilR2.x * exp(-4.6f * C);
	const float Room = max(0.0f, 1.0f - S.b) * PoreCm;
	const float Infil = min(Pond, min(K * DirtDt, Room));
	S.b += Infil / PoreCm;
	Pond -= Infil;

	// 4. overflow: a Wet brush or a flood can push moisture past saturation
	if (S.b > 1.0f)
	{
		Pond += (S.b - 1.0f) * PoreCm;
		S.b = 1.0f;
	}

	// 5. drainage down through the layer
	const float Drain = DirtDrainPerSec * exp(-3.45f * C);
	S.b -= Drain * max(0.0f, S.b - SoilR2.y) * DirtDt;

	// 6. drying at the surface, down to what air-dry dirt holds on to
	S.b -= DirtEvapPerSec * SoilR2.w * DirtDt * saturate((S.b - DirtAmbientMoisture) / 0.05f);
	S.b = max(S.b, 0.0f);

	// 7. erosion: docs/SoilPhysics.md 5b. Flowing water shears the bed with
	//    tau = rho g h S on the bed slope S. The run-off model moves water a
	//    cell a step, far faster than a real sheet, so its resting depth says
	//    nothing about the flow: h comes from the THROUGHPUT instead, by
	//    Manning (h = (q n / sqrt S)^0.6, n = 0.03 for bare soil), which puts a
	//    22 degree flank under 30 mm/min at the few pascals a real one sees.
	//    Past the soil's critical shear (higher when packed) grains detach at
	//    the erodibility rate, up to what the water passing can carry (a volume
	//    fraction per Pa of the throughput). Water carrying more than it can
	//    drops the excess at the settling velocity; water that has gone (soaked
	//    in, dried) drops everything. Solid cm in, solid cm out: the audit counts
	//    what is in the water as "in the run-off". Moves under a floor are
	//    skipped, as in the slump: float rounding on thousands of tiny ones
	//    makes dirt.
	float Deposited = 0.0f;
	if (DirtErosionEnabled != 0)
	{
		const float4 SoilR5 = DirtSoilRow(Soil, 5);
		const float Slope = max(MaxBedDropCm, 0.0f) / DirtTexelSizeCm;
		const float ThroughputM2s = Moved * 0.01f * DirtTexelSizeCm * 0.01f / DirtDt;      // m^2/s per unit width
		const float DepthM = (Slope > 1e-4f && ThroughputM2s > 0.0f)
			? pow(ThroughputM2s * 0.03f / sqrt(Slope), 0.6f)
			: 0.0f;
		const float TauPa = 9810.0f * DepthM * Slope;
		const float TauC = SoilR5.y * (1.0f + 2.0f * C);
		const float Capacity = SoilR5.w * DirtErosionPace * TauPa * (Pond + Moved);
		if (Sed < Capacity)
		{
			const float Detach = min(min(SoilR5.x * DirtErosionPace * max(TauPa - TauC, 0.0f) * DirtDt, Capacity - Sed), max(S.r, 0.0f));
			if (Detach >= 1e-4f)
			{
				S.r -= Detach;
				Sed += Detach;
			}
		}
		else if (Sed > 0.0f)
		{
			Deposited = min(Sed - Capacity, Sed * SoilR5.z * DirtDt / max(Pond, 0.05f));
			if (Deposited < 1e-4f)
			{
				Deposited = 0.0f;
			}
		}
	}
	if (Pond <= 1e-4f && Sed > 0.0f)
	{
		Deposited = Sed;                 // the water is gone; whatever it carried is on the ground
	}
	if (Deposited > 0.0f)
	{
		// Settled dirt lands loose and soaked, and takes the surface over as it
		// piles up (the skin rule the deposit fold uses).
		const float W = Deposited / (Deposited + 2.0f);
		S.g = saturate(lerp(S.g, 0.05f, W));
		S.b = saturate(lerp(S.b, 1.0f, W));
		S.r += Deposited;
		Sed -= Deposited;
	}
	S.a = DirtBedrock(P) + DirtBulkCm(S.r, S.g, Soil);

	DirtStateOut[P] = S;
	DirtPondOut[P] = float2(Pond, max(Sed, 0.0f));
}

#endif // DIRT_WATER_PASS

// ---------------------------------------------------------------------------
// Resolve — surface normal + debug colour
// ---------------------------------------------------------------------------

#if DIRT_RESOLVE_PASS

float DirtTexelSizeCm;
float DirtMaxCohesiveHeightCm;
int DirtDebugMode;
float DirtDebugLayerRangeCm;

Texture2D<float2> DirtPondIn;

// The brush and slump passes ping-pong between two state textures, so which one
// holds the answer changes from frame to frame. Resolve copies the finished state
// into one fixed target, which is what the display material samples — that way the
// material has a stable texture to bind to.
RWTexture2D<float4> DirtDisplayOut;
RWTexture2D<float4> DirtNormalOut;
RWTexture2D<float4> DirtDebugOut;

float3 DirtHeatRamp(float T)
{
	T = saturate(T);
	float3 C = lerp(float3(0.05f, 0.05f, 0.55f), float3(0.0f, 0.75f, 0.9f), saturate(T * 4.0f));
	C = lerp(C, float3(0.1f, 0.8f, 0.15f), saturate(T * 4.0f - 1.0f));
	C = lerp(C, float3(0.95f, 0.9f, 0.1f), saturate(T * 4.0f - 2.0f));
	C = lerp(C, float3(0.9f, 0.1f, 0.05f), saturate(T * 4.0f - 3.0f));
	return C;
}

float DirtSurfaceClamped(int2 C)
{
	return DirtStateIn.Load(int3(clamp(C, int2(0, 0), DirtResolution - 1), 0)).a;
}

float DirtWaterTopClamped(int2 Q)
{
	Q = clamp(Q, int2(0, 0), DirtResolution - 1);
	return DirtState(Q).a + DirtPondIn.Load(int3(Q, 0)).x;
}

[numthreads(DIRT_THREADGROUP_SIZE, DIRT_THREADGROUP_SIZE, 1)]
void MainResolveCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 P = int2(DispatchThreadId.xy);
	if (!DirtInBounds(P))
	{
		return;
	}

	const float4 S = DirtState(P);
	const float Pond = DirtPondIn.Load(int3(P, 0)).x;

	// What is drawn is the top of the water where there is any: a puddle is a
	// flat sheet over the rut, not a groove in it. The height window that the
	// wheel reads takes the pond off again to get the dirt underneath.
	float4 Shown = S;
	Shown.a = S.a + Pond;
	DirtDisplayOut[P] = Shown;

	// --- world-space normal from central differences of the water top ---------
	const float HL = DirtWaterTopClamped(P - int2(1, 0));
	const float HR = DirtWaterTopClamped(P + int2(1, 0));
	const float HD = DirtWaterTopClamped(P - int2(0, 1));
	const float HU = DirtWaterTopClamped(P + int2(0, 1));

	const float DHDX = (HR - HL) / (2.0f * DirtTexelSizeCm);
	const float DHDY = (HU - HD) / (2.0f * DirtTexelSizeCm);
	const float3 N = normalize(float3(-DHDX, -DHDY, 1.0f));

	DirtNormalOut[P] = float4(N * 0.5f + 0.5f, 1.0f);

	// --- debug / base colour -------------------------------------------------
	float3 C;

	if (DirtDebugMode == 1)              // dirt layer thickness (bulk, what you would measure with a ruler)
	{
		C = DirtHeatRamp(DirtBulkCm(S.r, S.g, DirtSoilAt(P)) / max(DirtDebugLayerRangeCm, 1e-3f));
	}
	else if (DirtDebugMode == 2)         // compaction
	{
		C = lerp(float3(0.9f, 0.85f, 0.6f), float3(0.35f, 0.15f, 0.1f), saturate(S.g));
	}
	else if (DirtDebugMode == 3)         // moisture, with ponded water in strong blue
	{
		C = lerp(float3(0.85f, 0.75f, 0.55f), float3(0.06f, 0.12f, 0.28f), saturate(S.b));
		C = lerp(C, float3(0.1f, 0.35f, 0.95f), saturate(Pond / 0.5f));
	}
	else if (DirtDebugMode == 4)         // stability vs angle of repose
	{
		// Same eight directions, distances and strength rule the slump pass uses,
		// so this view shows exactly what the sim considers unstable. A face held
		// only by cohesion reads exactly 1.0: yellow, "standing on cohesion".
		const uint Soil = DirtSoilAt(P);
		float TanPhi, CohesionKPa;
		DirtSoilStrength(S, Soil, TanPhi, CohesionKPa);
		float Ratio = 0.0f;
		UNROLL
		for (int i = 0; i < 8; ++i)
		{
			const int2 Q = clamp(P + DirtOffsets8[i], int2(0, 0), DirtResolution - 1);
			const float Drop = S.a - DirtStateIn.Load(int3(Q, 0)).a;
			const float Allowed = DirtAllowedDrop(Drop, DirtTexelSizeCm * DirtNeighbourDist[i], TanPhi, CohesionKPa,
												  DirtSoilUnitWeight(Soil), DirtMaxCohesiveHeightCm);
			Ratio = max(Ratio, Drop / max(Allowed, 1e-4f));
		}
		C = (Ratio <= 1.0f)
			? lerp(float3(0.1f, 0.6f, 0.15f), float3(0.95f, 0.9f, 0.1f), Ratio)
			: lerp(float3(0.95f, 0.9f, 0.1f), float3(0.95f, 0.05f, 0.05f), saturate(Ratio - 1.0f));
	}
	else if (DirtDebugMode == 5)         // bedrock exposure
	{
		C = (S.r < 0.5f) ? float3(0.9f, 0.1f, 0.1f) : float3(0.25f, 0.3f, 0.25f);
	}
	else if (DirtDebugMode == 6)         // absolute slope angle
	{
		const float SlopeDeg = degrees(acos(saturate(N.z)));
		C = DirtHeatRamp(SlopeDeg / 90.0f);
	}
	else                                 // 0 — plain dirt
	{
		// Real soil albedo is 0.15-0.35; the earlier 0.72 sand read as near-white
		// under a full sun with auto exposure and hid every shape.
		// Each soil has its own dry and packed colours (the table, rows 3 and 4).
		const uint TintSoil = DirtSoilAt(P);
		C = lerp(DirtSoilRow(TintSoil, 3).rgb, DirtSoilRow(TintSoil, 4).rgb, saturate(S.g));
		C = lerp(C, C * 0.40f, saturate(S.b));
		// where the dirt has been scraped away, cold grey bedrock shows through
		C = lerp(float3(0.35f, 0.33f, 0.31f), C, saturate(S.r / 3.0f));
		// standing water: a dark, slightly blue sheen
		C = lerp(C, float3(0.08f, 0.10f, 0.13f), saturate(Pond / 0.3f) * 0.85f);
	}

	DirtDebugOut[P] = float4(C, 1.0f);
}

#endif // DIRT_RESOLVE_PASS
